# Copy this file to .env and fill in the values.

# --- Database (Neon: https://neon.tech -> create project -> copy connection string) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Anthropic AI (https://console.anthropic.com -> API keys) ---
AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-...
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Clerk auth (https://dashboard.clerk.com -> your app -> API keys) ---
# The publishable key must be set TWICE with the SAME value:
#   CLERK_PUBLISHABLE_KEY       -> used by the API server
#   VITE_CLERK_PUBLISHABLE_KEY  -> used by the frontend (Vite only exposes VITE_* vars)
CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Admin panel API token (any random string for local dev) ---
ADMIN_API_TOKEN=local-dev-admin-token
