# Copy this file to .env and fill in the values.

# --- Database (Neon: https://neon.tech -> create project -> copy connection string) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- AI provider: OpenAI (https://platform.openai.com -> API keys) ---
# The app talks to OpenAI via an Anthropic-shaped shim in
# lib/integrations-anthropic-ai/src/client.ts.
OPENAI_API_KEY=sk-...
# AI_MODEL is used everywhere except resume generation (cheap/fast).
AI_MODEL=gpt-4o-mini
# AI_MODEL_RESUME is used only by the resume pipeline, which needs a stronger model
# for its multi-stage reasoning (JD analysis, evidence mapping, drafting, critique).
AI_MODEL_RESUME=gpt-4o

# --- Clerk auth (https://dashboard.clerk.com -> your app -> API keys) ---
# The publishable key must be set TWICE with the SAME value:
#   CLERK_PUBLISHABLE_KEY       -> used by the API server
#   VITE_CLERK_PUBLISHABLE_KEY  -> used by the frontend (Vite only exposes VITE_* vars)
CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Admin panel API token (any random string for local dev) ---
ADMIN_API_TOKEN=local-dev-admin-token
